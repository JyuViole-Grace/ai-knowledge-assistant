# The app reads these from the process environment (export them, or use
# `env_file` in docker compose). It does not load .env files by itself.

# Ollama server used by the CLI and the API.
OLLAMA_URL=http://localhost:11434

# API: directory that clients are allowed to index (default: documents).
RAG_DOCS_ROOT=documents

# API: when set, every endpoint except /health requires this value in the
# X-API-Key header. Leave empty to disable authentication (local use only).
RAG_API_KEY=
